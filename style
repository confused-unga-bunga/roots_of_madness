body {
  background-color: black;
  color: #0f0;
  font-family: 'Courier New', monospace;
  padding: 50px;
  text-align: center;
}

a {
  color: #f00;
  text-decoration: none;
}

a:hover {
  text-shadow: 0 0 10px red;
}

.container {
  border: 1px solid #0f0;
  padding: 20px;
  background: rgba(0, 0, 0, 0.8);
}
/* Global Styles */
body {
    font-family: Arial, sans-serif;
    background-color: #1c1c1c;
    color: #ddd;
    margin: 0;
    padding: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
    overflow: hidden;
}

.container {
    text-align: center;
    max-width: 800px;
    padding: 20px;
}

h1 {
    font-size: 3em;
    margin-bottom: 10px;
    color: #ff6347;
}

p {
    font-size: 1.2em;
    margin-bottom: 15px;
}

.clue {
    margin-top: 20px;
    padding: 20px;
    border: 2px solid #ff6347;
    border-radius: 10px;
    background-color: #333;
    color: #ff6347;
}

.clue a {
    color: #ff6347;
    text-decoration: none;
    font-weight: bold;
}

.clue a:hover {
    color: #ff4500;
}

footer {
    margin-top: 30px;
    font-size: 0.9em;
    color: #aaa;
}

footer a {
    color: #aaa;
    text-decoration: none;
}

footer a:hover {
    color: #fff;
}
